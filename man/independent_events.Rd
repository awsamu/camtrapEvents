  species  = "Kobus kob",
  datetime = as.POSIXct("2021-06-02 08:00:00", tz = "UTC") +
               60 * c(0, 5, 10, 15, 90),
  females  = c(3, 5, 2, 3, 1),
  juveniles = c(0, 0, 1, 1, 0)
